<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TorrPlayer"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Android TV плеер с поддержкой торрентов"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- КНОПКА ОТКРЫТЬ ПЛЕЕР -->
    <Button
        android:id="@+id/btn_open_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Открыть плеер (тест)" />

    <!-- КНОПКА ПЕРЕКЛЮЧЕНИЯ ДЕКОДЕРА -->
    <Button
        android:id="@+id/btn_switch_decoder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Переключить декодер (HW/SW)" />

    <!-- КНОПКА ПРОВЕРКИ ОБНОВЛЕНИЙ -->
    <Button
        android:id="@+id/btn_check_updates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Проверить обновления" />

    <!-- КНОПКА НАСТРОЕК -->
    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Настройки" />

</LinearLayout>
