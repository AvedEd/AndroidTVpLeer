<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:text="@string/server_host"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/edit_host"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:textColor="@color/text_primary" />

    <Button
        android:id="@+id/btn_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/test_connection" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/seek_step"
        android:textColor="@color/text_secondary" />

    <Spinner
        android:id="@+id/spinner_seek"
        android:layout_width="240dp"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/check_buffer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/show_buffer"
        android:textColor="@color/text_primary" />

    <CheckBox
        android:id="@+id/check_resume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resume_playback"
        android:textColor="@color/text_primary" />

    <Button
        android:id="@+id/btn_check_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/check_update" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@android:string/ok" />

</LinearLayout>
